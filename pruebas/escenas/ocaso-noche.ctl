# Empalme del ocaso con la noche (B-23 §1): la plataforma de noche-suelo a varias horas, luna llena (día 0).
close
command gamemode spectator
command weather clear
command gamerule advance_time false
command tp @s 301.5 103.5 296.5 0 40
sleep 6
command time set 12000
look 0 40
sleep 7
screenshot ocaso-noche-12000
command time set 12500
look 0 40
sleep 7
screenshot ocaso-noche-12500
command time set 12800
look 0 40
sleep 7
screenshot ocaso-noche-12800
command time set 13100
look 0 40
sleep 7
screenshot ocaso-noche-13100
command time set 13500
look 0 40
sleep 7
screenshot ocaso-noche-13500
command time set 14000
look 0 40
sleep 7
screenshot ocaso-noche-14000
command time set 15000
look 0 40
sleep 7
screenshot ocaso-noche-15000
command time set 16500
look 0 40
sleep 7
screenshot ocaso-noche-16500
command time set 18000
look 0 40
sleep 7
screenshot ocaso-noche-18000
