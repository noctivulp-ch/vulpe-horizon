# Fractal por altura (B-23 §2.3): medianoche, mirando al cenit desde Y 90, 300, 1000, 2000 y 5000.
close
command gamemode spectator
command weather clear
command gamerule advance_time false
time 18000
command tp @s 170.5 90 166.5
sleep 4
look 0 -90
sleep 3
screenshot fractal-altura-90
command tp @s 170.5 300 166.5
sleep 4
look 0 -90
sleep 3
screenshot fractal-altura-300
command tp @s 170.5 1000 166.5
sleep 4
look 0 -90
sleep 3
screenshot fractal-altura-1000
command tp @s 170.5 2000 166.5
sleep 4
look 0 -90
sleep 3
screenshot fractal-altura-2000
command tp @s 170.5 5000 166.5
sleep 4
look 0 -90
sleep 3
screenshot fractal-altura-5000
command tp @s 170.5 90 166.5
